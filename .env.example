# 复制为 .env 后填写。不要把能登录的哈希或会话密钥写进这个文件。
ADMIN_USER=rende
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# 生产环境不要改成 0。不设置时 cookie 带 Secure。
# 只有本机 http 才需要 COOKIE_SECURE=0，否则浏览器不保存登录 cookie。
# COOKIE_SECURE=1

# 只有 Nginx 反代时设为 1，限流才使用访客 IP。
TRUST_PROXY=0

PORT=3030
DATA_DIR=data

# 生产环境不要打开。设为 1 时，空库会写入六道示例菜，只给本机试用。
# SEED_DEMO=

# 五项都填才使用阿里云 OSS（S3 兼容接口）。少填一项时进程会拒绝启动。
# 都不填时图片写在 DATA_DIR/objects。S3_PREFIX 不计入这五项。
# S3_ENDPOINT 填区域域名，不要带 Bucket，例如 https://oss-cn-hangzhou.aliyuncs.com。
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# 可选。去掉首尾空白后加在对象键前面，例如 recipes/。不要以 / 或 \ 开头。已有对象之后不要再改。
# S3_PREFIX=
