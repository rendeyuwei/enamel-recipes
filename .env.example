# 复制为 .env 后填写。不要把能登录的哈希或会话密钥写进这个文件。
ADMIN_USER=rende
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# 生产环境不要改成 0。不设置时 cookie 带 Secure。
# 只有本机 http 才需要 COOKIE_SECURE=0，否则浏览器不保存登录 cookie。
# COOKIE_SECURE=1

# 只有 Nginx 反代时设为 1，限流才使用访客 IP。
TRUST_PROXY=0

PORT=3030
DATA_DIR=data

# 生产环境不要打开。设为 1 时，空库会写入六道示例菜，只给本机试用。
# SEED_DEMO=

# 四项都填才使用 Cloudflare R2。少填一项时进程会拒绝启动。
# 都不填时图片写在 DATA_DIR/objects。
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
